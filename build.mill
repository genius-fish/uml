//| repositories:
//| - https://repo.genius.fish/releases
//| - https://repo.genius.fish/snapshots
//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.0
//| - fish.genius::mill-release::0.5.0

package build

import coursier.core.Authentication
import coursier.maven.MavenRepository
import mill.*
import mill.scalalib.*
import mill.scalalib.publish.*
import mill.scalalib.scalafmt.*

import com.goyeau.mill.scalafix.ScalafixModule
import fish.genius.mill.release.GeniusFishReleaseModule

// ---------------------------------------------------------------------------
// Version catalog
// ---------------------------------------------------------------------------
object V:
  val scala      = "3.8.3"
  val zio        = "2.1.25"
  val osLib      = "0.11.8"
  val elk        = "0.12.0"
  val xbaseLib   = "2.36.0"
  val zioJson    = "0.7.3"

// ---------------------------------------------------------------------------
// Release module (git-tag versioning, release workflow, AI release notes)
// ---------------------------------------------------------------------------
object release extends GeniusFishReleaseModule

// ---------------------------------------------------------------------------
// Shared publishing settings
// ---------------------------------------------------------------------------
trait GeniusFishPublishSettings extends PublishModule:
  def publishVersion = release.gitVersion()

  def pomSettings = PomSettings(
    description = "ArchiMate diagrams for Scala 3: an ELK layout drawn as TikZ, SVG and PNG",
    organization = "fish.genius",
    url = "https://github.com/genius-fish/uml",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github("genius-fish", "uml"),
    developers = Seq(
      Developer("jlust", "Jurgen Lust", "https://genius.fish")
    ),
  )

  def geniusFishRepositories: Seq[MavenRepository] =
    val auth =
      for
        user  <- sys.env.get("REPO_USERNAME")
        token <- sys.env.get("REPO_TOKEN")
      yield Authentication(user, token)

    Seq(
      MavenRepository("https://repo.genius.fish/releases", authentication = auth),
      MavenRepository("https://repo.genius.fish/snapshots", authentication = auth),
    )

end GeniusFishPublishSettings

// ---------------------------------------------------------------------------
// Base trait for all modules
// ---------------------------------------------------------------------------
trait GeniusFishModule
  extends ScalaModule
    with ScalafmtModule
    with ScalafixModule
    with GeniusFishPublishSettings:
  def scalaVersion = V.scala

  def scalacOptions = Seq(
    "-Wunused:all",
    "-unchecked",
    "-deprecation",
    "-feature",
    "-Xmax-inlines:128",
  )

  def repositoriesTask = Task.Anon {
    super.repositoriesTask() ++ geniusFishRepositories
  }

  trait GeniusFishTests extends ScalaTests with ScalafmtModule with ScalafixModule:
    def testFramework = "zio.test.sbt.ZTestFramework"

    def forkArgs = Seq(
      "-Xmx4G",
      "-Xms2G",
      "-Xss16M",
      "-XX:+UseG1GC",
      "-XX:MaxGCPauseMillis=200",
    )

    def mvnDeps = Seq(
      mvn"dev.zio::zio-test:${V.zio}",
      mvn"dev.zio::zio-test-sbt:${V.zio}",
    )

  end GeniusFishTests

end GeniusFishModule

// ---------------------------------------------------------------------------
// Module: core (the ArchiMate vocabulary: element, layer and relationship types; no deps)
// ---------------------------------------------------------------------------
object core extends GeniusFishModule:
  def artifactName = "genius-uml-core"

  object test extends GeniusFishTests

// ---------------------------------------------------------------------------
// Module: scene (an ArchiMate graph laid out as a 3D scene: ELK, JSON, Blender builder)
// ---------------------------------------------------------------------------
object scene extends GeniusFishModule:
  def artifactName = "genius-uml-scene"
  def moduleDeps   = Seq(core)

  def mvnDeps = Seq(
    mvn"org.eclipse.elk:org.eclipse.elk.core:${V.elk}",
    mvn"org.eclipse.elk:org.eclipse.elk.graph:${V.elk}",
    mvn"org.eclipse.elk:org.eclipse.elk.alg.common:${V.elk}",
    mvn"org.eclipse.elk:org.eclipse.elk.alg.layered:${V.elk}",
    // ELK's option classes are written in Xtend and call its runtime, which ELK's
    // poms do not declare
    mvn"org.eclipse.xtext:org.eclipse.xtext.xbase.lib:${V.xbaseLib}",
    mvn"dev.zio::zio-json:${V.zioJson}",
    // zio-json alone would bring an older zio than the rest of the build
    mvn"dev.zio::zio:${V.zio}",
  )

  object test extends GeniusFishTests:
    // the contract spec checks the builder against the options DSL.md documents
    def dslMd   = Task.Source(mill.api.BuildCtx.workspaceRoot / "DSL.md")
    def forkEnv = super.forkEnv() ++ Map("SCENE_DSL_MD" -> dslMd().path.toString)

// ---------------------------------------------------------------------------
// Module: diagram (an ArchiMate graph as a flat diagram: the scene's ELK layout, boxes
// sized to their names, drawn as TikZ for LaTeX, as SVG and as PNG via Java2D)
// ---------------------------------------------------------------------------
object diagram extends GeniusFishModule:
  def artifactName = "genius-uml-diagram"
  def moduleDeps   = Seq(scene)

  object test extends GeniusFishTests

// ---------------------------------------------------------------------------
// Module: testkit (golden-file assertions for ZIO Test)
// ---------------------------------------------------------------------------
object testkit extends GeniusFishModule:
  def artifactName = "genius-uml-testkit"

  def mvnDeps = Seq(
    mvn"dev.zio::zio:${V.zio}",
    mvn"dev.zio::zio-test:${V.zio}",
    mvn"com.lihaoyi::os-lib:${V.osLib}",
  )

  object test extends GeniusFishTests
end testkit

// ---------------------------------------------------------------------------
// Module: examples (runnable end-to-end showcases, not published)
// ---------------------------------------------------------------------------
object examples extends GeniusFishModule:
  def artifactName = "genius-uml-examples"
  def moduleDeps   = Seq(core, scene, diagram)
